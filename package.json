{
  "name": "my-garmin-mcp",
  "version": "0.1.0",
  "description": "Personal MCP server exposing Garmin data to Claude",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "rotate-key": "tsx scripts/rotate-key.ts",
    "server": "bash scripts/server.sh"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "~2.3.1",
    "express": "^5.3.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "~2.3.1",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.5",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.4"
  }
}
