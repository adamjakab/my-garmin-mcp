# Server (optional; defaults shown)
PORT=3334
HOST=127.0.0.1
DATA_DIR=./data
# Public hostname(s) the server is reached under behind a reverse proxy, comma separated (loopback is always allowed)
# ALLOWED_HOSTS=mcp.example.com

# Garmin Connect account (always the owner's)
GARMIN_EMAIL=you@example.com
GARMIN_PASSWORD=change-me
# Where the Garmin session tokens are cached between runs
GARMIN_TOKEN_STORE=./data/garmin-tokens

# MCP access key (the one key clients present as a Bearer token). Replace with: uv run rotate-key
MCP_ACCESS_KEY=gmcp_replace-me
